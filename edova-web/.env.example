# Base URL learning-resource assets (video, PDF, converted PPT/DOCX/XLSX)
# are served from. Direct S3 bucket URL for now; swap to a CloudFront domain
# later — this is the only line that needs to change. Must end with "/".
VITE_S3_BUCKET_URL=https://innuxai-edova-coteacher.s3.ap-south-1.amazonaws.com/

# ncert_rag FastAPI service — teacher upload presign/complete endpoints
VITE_API_URL=http://localhost:8001

# edova-camel CAMEL society — AI lesson-plan generation endpoint
VITE_AI_API_URL=http://localhost:8002

# Ask-the-Textbook RAG service — answers chat questions with exact NCERT
