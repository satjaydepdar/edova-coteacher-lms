# Safety-net repo (added before a multi-file refactor) — keep it lean, source-focused.
node_modules/
.venv/
venv/
__pycache__/
*.pyc
dist/
build/
.env
*.env.local

# Runtime data / generated artifacts, not source.
ncert_rag/clerk/clerk.db
ncert_rag/clerk/*.log
edova-third-brain/okf-bundle/cache/
graphify-out/cache/

# Not required to run the app — reference material, tooling output, or
# standalone/unwired sub-projects. Keep the repo scoped to the 4 runtime
# services (edova-web, edova-camel, edova-backend, ncert_rag) + db/ +
# edova-third-brain/okf-bundle (read at runtime by edova-camel grounding).
.claude/
.github/skills/
instructions/
Learning-resources/
innuxai-edova-coteacher_S3/
edova-interactive-learning-engine/
_decomp/
graphify-out/

# Runtime logs
*.log

# macOS Finder metadata
.DS_Store

# Video ingest working files — source videos already pushed to S3 by
# edova-third-brain/tools/s3_push.py; the app serves them from S3 via
# manifest s3_key, not from these local copies.
edova-third-brain/okf-bundle/attachments/
edova-third-brain/subjects/*/uploads/
ncert_rag/data/staging/*.mp4
