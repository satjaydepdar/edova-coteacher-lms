# DeepSeek — LLM tasks (chatbot, semantic-search answer generation, OKF doc Q&A)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
BASE_URL=https://api.deepseek.com

# PostgreSQL / pgvector — same database as the main Edova app (db/), not a
# standalone ncert_db. Adjust the port if your local Postgres isn't on the
# default 5432 (e.g. db/'s local dev container uses 5433 to avoid clashing
# with a native Postgres install — match whatever db/.env actually uses).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edova

# Gemini — embeddings only (gemini-embedding-2, truncated to 768 dims —
# see db/migrations/20260101000014_gemini_768_embeddings.sql)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# LlamaParse — PDF extraction (get a key at https://cloud.llamaindex.ai)
LLAMA_CLOUD_API=llx-your-llamacloud-api-key-here

# Paths
PDF_DIR=./data/pdfs
# Local directory holding an Open Knowledge Format bundle (Google Cloud's
# markdown+YAML-frontmatter spec) — see ingestion/okf_bundle_parser.py.
# Defaults to the real bundle already in this repo, sibling to ncert_rag/.
OKF_BUNDLE_DIR=../edova-brain/OKF/math-Knowledge
# edova-brain/OKF/'s resource: fields point back into ../edova-brain/math-Knowledge/
# for the substantive content (worked examples, question banks) — OKF
# itself is a thin pointer layer. Set to false to ingest only the OKF
# concept bodies as-is, without following those links.
OKF_RESOLVE_RESOURCES=true
