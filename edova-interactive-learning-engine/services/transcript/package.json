{
  "name": "@edova/transcript-service",
  "version": "0.1.0",
  "description": "Transcript Extraction Service - converts a local MP4 video into a clean, timestamped transcript (transcript.json + transcript.md).",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "transcript": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "transcript": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "openai": "^4.68.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
