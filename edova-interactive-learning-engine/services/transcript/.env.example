# Copy this file to .env and fill in real values. Never commit .env.

# openai | whisper-cpp (whisper-cpp is a scaffolded extension point, not yet implemented)
TRANSCRIPTION_PROVIDER=openai

# Required when TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=

# OpenAI Whisper model name
WHISPER_MODEL=whisper-1

# Reserved for the future Whisper.cpp provider
WHISPER_CPP_BINARY=
WHISPER_CPP_MODEL=

# Optional override; defaults to the binary bundled by ffmpeg-static
FFMPEG_PATH=

# Sample rate (Hz) used when extracting mono audio for transcription
AUDIO_SAMPLE_RATE=16000

# Output directory (relative to cwd unless absolute), overridable via --output
OUTPUT_DIR=output

# Speaker label applied to every segment, overridable via --speaker
DEFAULT_SPEAKER=narrator
